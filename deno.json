{
  "name": "imai",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "tasks": {
    "dev": "deno run --watch --allow-all src/main.tsx",
    "test": "deno test --allow-all src/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "unstable": [
    "raw-imports"
  ],
  "exclude": [
    "docs/"
  ],
  "imports": {
    "@semos-labs/glyph": "npm:@semos-labs/glyph@^0.2.10",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/uuid": "jsr:@std/uuid@^1.0.0",
    "mobx-keystone": "npm:mobx-keystone@^1.20.0",
    "openai": "npm:openai@^6.33.0",
    "react": "npm:react@^19.0.0",
    "@types/react": "npm:@types/react",
    "mobx": "npm:mobx@^6.15.0",
    "mobx-react-lite": "npm:mobx-react-lite@^4.1.1",
    "react-dom": "npm:react-dom@^19.2.4"
  }
}
